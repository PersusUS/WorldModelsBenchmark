# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Experiment artifacts ---
# Model checkpoints are large (~32 MB each) and are not needed to reproduce
# the figures or tables: every number in the paper is derived from the
# metrics.json files, which ARE tracked.
*.pt
*.pth
*.ckpt

# Weights & Biases local run cache
wandb/

# Raw stdout captured from long benchmark runs
full_benchmark_output.txt

# --- Local tooling config ---
.claude/

# --- Working notes ---
# Internal development log. The documents themselves are tracked: findings,
# decisions, run history, and the scripts that check the paper. What stays out
# is the bulk and the noise -- archived results from invalidated runs, the
# stdout/stderr of every run, and the summary dumps, which regenerate.
_devlog/*
!_devlog/*.md
!_devlog/check-paper.py
!_devlog/check-numbers.py
!_devlog/diagnose-p12.py
!_devlog/backfill-tasks.py
!_devlog/run-seeds-5-9.sh

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
